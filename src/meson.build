package_dirs = [
  '-DPACKAGE_LOCALE_DIR="@0@"'.format(prefix / get_option('localedir')),
  '-DPACKAGE_SHARE_DIR="@0@"'.format(share_dir),
  '-DPACKAGE_SHARE_DIR_DEV="@0@"'.format(meson.project_source_root() / 'share'),
  '-DPACKAGE_UI_DIR="@0@"'.format(share_dir / 'ui'),
  '-DPACKAGE_UI_DIR_DEV="@0@"'.format(meson.project_source_root() / 'share' / 'ui'),
  '-DPACKAGE_PLUGIN_LIB_DIR="@0@"'.format(plugin_lib_dir),
  '-DPACKAGE_PLUGIN_DESCRIPTION_DIR="@0@"'.format(plugin_description_dir),
  '-DPACKAGE_PLUGIN_DESCRIPTION_DIR_DEV="@0@"'.format(meson.project_build_root() / 'plugins'),
  '-DDEFAULT_PLAYER_VIDEO_SINK="@0@"'.format(get_option('default-video-sink')),
  '-DDEFAULT_PLAYER_AUDIO_SINK="@0@"'.format(get_option('default-audio-sink')),
]

libsubtitleeditor = shared_library('subtitleeditor', [
  'color.cc',
  'command.cc',
  'commandsystem.cc',
  'cfg.cc',
  'debug.cc',
  'defaultcfg.cc',
  'document.cc',
  'encodings.cc',
  'extension/action.cc',
  'extension.cc',
  'extensioninfo.cc',
  'extensionmanager.cc',
  'filereader.cc',
  'filewriter.cc',
  'gtkmm_utility.cc',
  'isocodes.cc',
  'keyframes.cc',
  'player.cc',
  'reader.cc',
  'scriptinfo.cc',
  'spellchecker.cc',
  'style.cc',
  'stylemodel.cc',
  'styles.cc',
  'subtitle.cc',
  'subtitleeditorwindow.cc',
  'subtitleformatio.cc',
  'subtitleformatsystem.cc',
  'subtitlemodel.cc',
  'subtitles.cc',
  'subtitletime.cc',
  'subtitleview.cc',
  'timeutility.cc',
  'utility.cc',
  'waveform.cc',
  'widget_config_utility.cc',
  'writer.cc',
  'documents.cc',
  'gui/automaticspellchecker.cc',
  'gui/cellrenderercustom.cc',
  'gui/comboboxencoding.cc',
  'gui/comboboxframerate.cc',
  'gui/comboboxnewline.cc',
  'gui/comboboxsubtitleformat.cc',
  'gui/comboboxvideo.cc',
  'gui/dialogcharactercodings.cc',
  'gui/dialogfilechooser.cc',
  'gui/dialogutility.cc',
  'gui/spinbuttontime.cc',
  'gui/textviewcell.cc',
  'gui/treeviewextensionmanager.cc',
  ],
  cpp_args: package_dirs,
  include_directories: root_inc,
  dependencies: [gtkmm, libxml, enchant],
  version: '0.0.0',
  install: true)

executable('subtitleeditor', [
  'gui/application.cc',
  'gui/menubar.cc',
  'gui/statusbar.cc',
  'gstreamer_utility.cc',
  'main.cc',
  'options.cc',
  'vp/gstplayer.cc',
  'vp/videoplayer.cc',
  'we/waveformeditor.cc',
  'we/waveformrenderercairo.cc',
  'we/waveformrenderer.cc',
  'we/waveformrenderergl.cc',
  ],
  cpp_args: package_dirs,
  include_directories: root_inc,
  dependencies: [gtkmm, libxml, gstreamer],
  link_with: libsubtitleeditor,
  # Outside /usr the library directory may not be searched by the dynamic linker
  install_rpath: prefix == '/usr' ? '' : prefix / get_option('libdir'),
  install: true)
